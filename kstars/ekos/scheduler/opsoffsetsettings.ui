    <widget class="QLabel" name="dawnOffsetLabel">
     <property name="toolTip">
      <string>Moves the end of the night for jobs with the Twilight constraint, in hours. A positive value ends later: 0.5 keeps imaging until 30 minutes after astronomical dawn, useful with narrowband filters.</string>
     </property>
     <property name="text">
      <string>Dawn offset:</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QDoubleSpinBox" name="kcfg_DuskOffset">
     <property name="toolTip">
      <string>Moves the start of the night for jobs with the Twilight constraint, in hours. A negative value starts earlier: -0.5 starts 30 minutes before astronomical dusk, useful with narrowband filters.</string>
     </property>
     <property name="minimum">
      <double>-24.000000000000000</double>
     </property>
     <property name="maximum">
      <double>24.000000000000000</double>
